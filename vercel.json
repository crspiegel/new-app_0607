{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "play.tps-education.com" }],
      "destination": "/q",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [{ "type": "host", "value": "play.tps-education.com" }],
      "destination": "/q",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/q/:path*", "destination": "/play.html" },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "play.tps-education.com" }],
      "destination": "/play.html"
    }
  ]
}
